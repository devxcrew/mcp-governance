{
  "name": "@codexsun/mcp-governance",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Read-only shared repository governance MCP server",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && node ../../shared/mcp-governance/client/repository.mjs check:versions && devxcrew-tools lines:check",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check && npm run build",
    "mcp:connect": "node agent/connect.mjs",
    "mcp:verify": "node agent/connect.mjs --strict",
    "version:update": "node ../../shared/mcp-governance/client/repository.mjs version:bump",
    "github:now": "node ../../shared/mcp-governance/client/repository.mjs github:now",
    "fix:line-endings": "node ../../shared/mcp-governance/client/repository.mjs lines:fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "version-bump": "node ../../shared/mcp-governance/client/repository.mjs version:bump",
    "version:bump": "node ../../shared/mcp-governance/client/repository.mjs version:bump",
    "version:show": "node ../../shared/mcp-governance/client/repository.mjs version:show",
    "check:versions": "node ../../shared/mcp-governance/client/repository.mjs check:versions",
    "changelog:append": "node ../../shared/mcp-governance/client/repository.mjs changelog:append",
    "changelog:show": "node ../../shared/mcp-governance/client/repository.mjs changelog:show",
    "tools:lines:fix": "node ../../shared/mcp-governance/client/repository.mjs lines:fix",
    "lines:check": "node ../../shared/mcp-governance/client/repository.mjs lines:check",
    "cloud:snapshot": "tsx tools/snapshot.ts",
    "cloud:types": "wrangler types",
    "cloud:check": "npm run cloud:snapshot && npm run cloud:types && tsc -p tsconfig.cloud.json && npm run cloud:test && wrangler deploy --dry-run",
    "cloud:deploy": "npm run cloud:snapshot && wrangler deploy",
    "cloud:test": "tsx tools/cloud-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@devxcrew/tools": "0.1.3",
    "@types/node": "latest",
    "prettier": "3.9.6",
    "tsx": "latest",
    "typescript": "6.0.3",
    "wrangler": "^4.112.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devxcrew/mcp-governance.git"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
