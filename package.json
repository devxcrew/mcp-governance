{
  "name": "@codexsun/mcp-governance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only shared repository governance MCP server",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && devxcrew-tools check:versions && devxcrew-tools lines:check",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check && npm run build",
    "mcp:connect": "node client/connect.mjs",
    "mcp:verify": "node client/connect.mjs --strict",
    "version:update": "devxcrew-tools version:bump",
    "github:now": "devxcrew-tools github:now",
    "fix:line-endings": "devxcrew-tools lines:fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@devxcrew/tools": "0.1.3",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "6.0.3",
    "prettier": "3.9.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devxcrew/mcp-governance.git"
  },
  "allowScripts": {
    "esbuild": true
  }
}
